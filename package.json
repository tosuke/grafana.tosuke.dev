{
  "name": "grafana.tosuke.dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "WRANGLER_BUILD_CONDITIONS=workerd,worker,browser,module wrangler deploy",
    "test": "WRANGLER_WRITE_LOGS=false vitest",
    "ci:test": "WRANGLER_WRITE_LOGS=false vitest --run --reporter=github-actions",
    "generate": "run-p _generate:*",
    "_generate:wrangler": "wrangler types",
    "lint": "run-p -c _lint:*",
    "ci:lint": "run-s _ci:lint:*",
    "_lint:oxfmt": "oxfmt --check .",
    "_lint:oxlint": "oxlint -c .oxlintrc.json",
    "_lint:tsc": "tsc --build --noEmit tsconfig.json",
    "_ci:lint:oxfmt": "oxfmt --check .",
    "_ci:lint:oxlint": "oxlint -c .oxlintrc.json --format github",
    "_ci:lint:tsc": "tsc --build --noEmit tsconfig.json",
    "fix": "run-s _fix:*",
    "_fix:oxfmt": "oxfmt --write .",
    "_fix:oxlint": "oxlint -c .oxlintrc.json --fix"
  },
  "dependencies": {
    "@buf/opentelemetry_opentelemetry.bufbuild_es": "2.13.0-20260722205108-41ecbd638b41.1",
    "@buf/prometheus_prometheus.bufbuild_es": "2.13.0-20260707164124-2360da55afce.1",
    "@bufbuild/protobuf": "^2.14.0",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/playwright": "^1.3.5",
    "@connectrpc/connect": "^2.1.2",
    "@hono/zod-validator": "^0.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ai": "^7.0.66",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.13.2",
    "jose": "^6.2.9",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.2.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.125.0"
  },
  "packageManager": "pnpm@11.23.0"
}

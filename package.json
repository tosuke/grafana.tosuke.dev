{
  "name": "grafana.tosuke.dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy",
    "test": "WRANGLER_WRITE_LOGS=false vitest",
    "generate": "run-p _generate:*",
    "_generate:wrangler": "wrangler types",
    "lint": "run-p _lint:*",
    "_lint:oxfmt": "oxfmt --check .",
    "_lint:oxlint": "oxlint -c .oxlintrc.json",
    "_lint:tsc": "tsc --build --noEmit tsconfig.json",
    "fix": "run-s _fix:*",
    "_fix:oxfmt": "oxfmt --write .",
    "_fix:oxlint": "oxlint -c .oxlintrc.json --fix"
  },
  "dependencies": {
    "@buf/opentelemetry_opentelemetry.bufbuild_es": "2.13.0-20260722205108-41ecbd638b41.1",
    "@buf/prometheus_prometheus.bufbuild_es": "2.13.0-20260707164124-2360da55afce.1",
    "@bufbuild/protobuf": "^2.14.0",
    "@cloudflare/containers": "^0.3.7",
    "@connectrpc/connect": "^2.1.2",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.121.0"
  },
  "packageManager": "pnpm@11.21.0"
}

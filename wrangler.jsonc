{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grafana",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "cache": {
    "enabled": true,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
    },
  },
  "vars": {
    "ENV": "env",
  },
  "ai": {
    "binding": "AI",
  },
  "containers": [
    {
      "class_name": "Grafana",
      "image": "./grafana/Dockerfile",
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GRAFANA",
        "class_name": "Grafana",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Grafana"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["WebDavTest"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["LtxTest"],
      "deleted_classes": ["WebDavTest"],
    },
    {
      "tag": "v4",
      "deleted_classes": ["LtxTest"],
    },
  ],
  "env": {
    "production": {
      "vars": {
        "ENV": "prod",
      },
      "ai": {
        "binding": "AI",
      },
      "containers": [
        {
          "name": "grafana",
          "class_name": "Grafana",
          "image": "./grafana/Dockerfile",
          "instance_type": "basic",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GRAFANA",
            "class_name": "Grafana",
          },
        ],
      },
    },
  },
}

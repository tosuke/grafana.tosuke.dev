{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grafana",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "cache": {
    "enabled": true,
  },
  "ai": {
    "binding": "AI",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
    },
  },
  "containers": [
    {
      "class_name": "Grafana",
      "image": "./grafana/Dockerfile",
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GRAFANA",
        "class_name": "Grafana",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Grafana"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["WebDavTest"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["LtxTest"],
      "deleted_classes": ["WebDavTest"],
    },
    {
      "tag": "v4",
      "deleted_classes": ["LtxTest"],
    },
  ],
}

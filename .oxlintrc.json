{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "ignorePatterns": ["dist"],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "zod",
            "message": "Use `import * as z from \"zod/mini\"` instead."
          }
        ]
      }
    ],
    "unicorn/import-style": [
      "error",
      {
        "styles": {
          "zod/mini": {
            "default": false,
            "named": false,
            "namespace": true,
            "unassigned": false
          }
        }
      }
    ]
  },
  "env": {
    "builtin": true
  }
}

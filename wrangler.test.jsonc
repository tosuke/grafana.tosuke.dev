{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grafana",
  "main": "src/index.stub.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENV": "dev",
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "r2_buckets": [
    {
      "binding": "GRAFANA_LTX_BUCKET",
      "bucket_name": "grafana-ltx-test",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TEST",
        "class_name": "Test",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Test"],
    },
  ],
}
